# ---------------------------------------------------------------------------
# ENS Agent Router - local configuration template (P3).
#
# Copy this file to `.env` and fill in your own values:
#     Copy-Item .env.example .env          (bash/mac: cp .env.example .env)
#
# `.env` is git-ignored and must never be committed. This file is tracked and must
# only ever contain placeholders like the ones below.
#
# Nothing in this file is a real credential.
#
# There is deliberately NO signing-key entry here, and there must never be one.
# Agent ENS records are published by signing with the user's MetaMask wallet in
# the browser during the front-end review step. This app never asks for, accepts,
# stores or transmits a private key or seed phrase, so there is nothing to put here.
# `npm run publish:dry-run` prints the records to publish and their expected values;
# it performs no transaction.
#
# The secrets below are ordinary API credentials, not wallet keys:
#   LLM_API_KEY      - a model-provider key, used server-side only
#   SEPOLIA_RPC_URL  - only a secret if you use a keyed/Pro RPC endpoint
# ---------------------------------------------------------------------------

# --- Model provider (any OpenAI-compatible API) -----------------------------
# The endpoint and the model id are read from configuration, never hardcoded at the
# call site. Swap these three values to change provider without touching code.
# Examples:
#   Groq       LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter LLM_BASE_URL=https://openrouter.ai/api/v1
#   Gemini     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama     LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=https://your-provider.example/v1

# Your provider's API key. Treat it as a secret: it stays server-side and is never
# sent to the browser, never printed, never committed.
LLM_API_KEY=replace-with-your-own-key

# Any model id your provider serves. Provider-specific, e.g. an OpenRouter model
# ending in `:free` for a free tier.
LLM_MODEL=replace-with-a-model-id

# Explicit timeout in milliseconds for the ROUTING decision only. Required: the model
# call is always bounded, so a hung free-tier request can never hang the app.
LLM_TIMEOUT_MS=20000

# Explicit bound on the routing decision, in tokens. The decision is a small JSON object
# ({ agentName, reason }); this keeps a routing call cheap on a free tier.
LLM_MAX_TOKENS=200

# --- Sepolia RPC ------------------------------------------------------------
# Agent metadata is read from ENS text records on Sepolia through viem's Universal
# Resolver. A *public* endpoint is fine and is not a secret. A keyed/Pro RPC URL IS a
# secret - keep it in `.env` and never commit it.
#
# This credential is NOT a signing key. It grants read access to a node and cannot sign
# anything. Publishing is signed by MetaMask in the browser, which uses the wallet's own
# RPC - this value is only used by the server for reads.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Explicit bound on every RPC call, so a hanging node cannot hang a request.
RPC_TIMEOUT_MS=15000

# --- ENS discovery ----------------------------------------------------------
# THE DISCOVERY ROOT. This is the single configured ENS name that every discovery
# strategy starts from. It is a root, not an agent list: the router reads which agents
# exist from records ON this name (and from subnames of it), never from a list in code.
# See docs/discovery-strategy.md.
AGENT_DISCOVERY_ROOT=replace-with-your-discovery-root-name.eth

# Which discovery strategies to run, comma separated, applied in order:
#   ens-registry - read the root's own registry text record, which lists its agent names
#   ens-subgraph - enumerate subnames of the root from the ENS subgraph
# Both are live ENS data. Neither is a list in source code.
AGENT_DISCOVERY_SOURCES=ens-registry,ens-subgraph

# Ceiling on how many agent names one discovery pass will resolve, so a poisoned or
# accidentally huge registry cannot turn into hundreds of RPC calls.
AGENT_DISCOVERY_MAX=25

# How long a successful discovery result is reused before it is re-read, in ms.
# ENS records rarely change during a session, so caching keeps free-tier RPC use low.
# The UI has an explicit "Refresh" action that bypasses this.
AGENT_CACHE_TTL_MS=60000

# --- ENS subgraph -----------------------------------------------------------
# Optional. Used only by the `ens-subgraph` discovery strategy. Public endpoints are
# fine and are not secrets; a keyed/DeGraph URL IS a secret and belongs in `.env`.
#
# SEPOLIA SUBGRAPH LIMIT (documented, not worked around): the public ENS subgraph indexes
# mainnet names. Sepolia names are frequently offchain/gasless, so this strategy may return
# nothing even when the names exist. That is why `ens-registry` is the primary strategy and
# why both are configurable rather than assumed. `npm run probe:registry` shows which
# strategy produced which names.
ENS_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/ensdomains/ens

# --- Forwarded agent requests ----------------------------------------------
# Explicit timeout in milliseconds for every forwarded request to a discovered agent.
# Required: a downstream agent must never be able to hang a route.
AGENT_TIMEOUT_MS=8000

# Explicit ceiling on the answer text returned by an agent, in characters. The agent
# reply is untrusted input, so its size is bounded before it is displayed.
AGENT_REPLY_MAX_CHARS=4000

# Allow `http://` for discovered agent endpoints when — and only when — the hostname is a
# loopback address (localhost, 127.0.0.1, [::1]). Required for the local demo, where the
# three agents run on localhost. Non-loopback `http://` is rejected even when this is true.
# Set to false in any deployed environment.
ALLOW_INSECURE_LOCAL_AGENTS=true

# --- Development fallback ---------------------------------------------------
# The three local agents have no published ENS records yet, so live discovery correctly
# finds nothing. When every live strategy returns zero agents AND this is true, the router
# falls back to `dev-registry/registry.json` so the demo is wired up end to end.
#
# This is NOT live discovery and is never presented as such: every agent it produces is
# tagged `source: "dev-registry"` in the API response and shown with a banner in the UI,
# while `source: "ens"` marks a genuinely discovered agent. Set to false to make ENS the
# only possible source and see the honest "no agents published yet" state.
ALLOW_DEV_REGISTRY_FALLBACK=true

# --- Routing decision bounds ------------------------------------------------
# Hard ceiling on how many discovered agents may be offered to the model for one decision.
# The candidate list is built only from agents discovered this pass, and the model's
# answer is membership-checked against it before anything is forwarded.
AGENT_ROUTE_MAX_CANDIDATES=8

# --- Agent services (how to start them) -------------------------------------
# These are the commands `npm run agents` uses. They are NOT endpoints: the router never
# reads these values. An agent's URL comes from its own ENS text record. They are here so
# one file documents how the local demo services are started.
#
# The values below are the defaults already baked into the per-agent scripts.
# AGENT_INVOICE_PORT=8791
# AGENT_CONTRACT_PORT=8792
# AGENT_BRAND_PORT=8793

# --- Server -----------------------------------------------------------------
PORT=8789